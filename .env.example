# Django 使用的配置模块
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=replace_with_a_random_private_signing_key
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1

# Django 使用的 MySQL 数据库连接配置
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=your_database
MYSQL_USER=your_database_user
MYSQL_PASSWORD=replace_with_private_password

# 总行下发数据导入目录挂载路径
AUTO_LOAD_DATA_BASE_DIR=/path/to/import-data

# 总行下发数据备份密码
BACKUP_PASSWORD=replace_with_private_backup_password

# 备份目标天数偏移（默认7天）
BACKUP_TARGET_DAY_OFFSET=7

# Celery 配置（消息队列、结果存储和时区）
CELERY_BROKER_URL=redis://branch-data-center-redis:6379/0
CELERY_RESULT_BACKEND=redis://branch-data-center-redis:6379/0
CELERY_TIMEZONE=Asia/Shanghai

# 是否真正执行指标 SQL（false 时只跑框架不执行 SQL）
DATAHUB_SQL_EXECUTION_ENABLED=false

# SQL 模板计算日均值时使用的默认天数
DATAHUB_DEFAULT_DAY_COUNT=1

# 结果表规则并发执行线程数
DATAHUB_RESULT_IMPORT_MAX_WORKERS=4

# 宿主机数据目录
HOST_DATA_BASE_DIR=/path/to/host/import-data

# 总行导入定时任务开关
HEAD_OFFICE_IMPORT_BEAT_ENABLED=false

# 总行导入每 10 分钟任务触发分钟
HEAD_OFFICE_IMPORT_BEAT_MINUTE=*/10

# 总行导入最大运行次数
IMPORT_MAX_RUN_COUNT=3

# 结果表导入检查任务触发频率(每 20 分钟)
DATAHUB_IMPORT_DISPATCH_MINUTE=*/20
